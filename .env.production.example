# Production Environment Variables Template
# Copy to .env.production and fill in actual values.
# Every key below is read by the code — dead keys were removed deliberately.

# ==========================================
# APPLICATION
# ==========================================
NODE_ENV=production
PORT=3000

# ==========================================
# DATABASE (Supabase Postgres)
# ==========================================
# Pooler (transaction port 6543) for runtime; direct (5432) for migrations.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ==========================================
# REDIS (shared cache)
# ==========================================
# Optional. Omit it and the cache falls back to per-process memory, which on
# serverless serves stale canteen data after every cold start.
REDIS_URL=redis://redis:6379

# ==========================================
# SUPABASE AUTH
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role: auth admin ops only. All data access goes through DATABASE_URL.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==========================================
# PAYMENT - RAZORPAY
# ==========================================
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=CHANGE_ME_SECURE_SECRET

# ==========================================
# PAYMENT - VYAPAR GATEWAY (UPI Dynamic QR)
# ==========================================
VYAPAR_API_KEY=your-vyapar-api-key
VYAPAR_MERCHANT_ID=your-merchant-id
VYAPAR_SECRET=your-vyapar-secret
VYAPAR_BASE_URL=https://api.vyapargateway.in

# ==========================================
# AI - GOOGLE GEMINI
# ==========================================
# Required for menu recommendations and review sentiment analysis.
GEMINI_API_KEY=your-gemini-api-key

# ==========================================
# EMAIL - RESEND (OTP delivery)
# ==========================================
# Send-only key is sufficient; /domains access is not required.
RESEND_API_KEY=re_xxxxxxxxxxxxx

# ==========================================
# QR SIGNING
# ==========================================
# HMAC secret for QR payloads. Auto-generated per boot if unset, which
# invalidates previously issued QR codes — set it explicitly in production.
QR_SECRET=CHANGE_ME_32_CHARS_MINIMUM

# ==========================================
# PUSH NOTIFICATIONS - FIREBASE CLOUD MESSAGING
# ==========================================
# Firebase is used ONLY for push. The database is Supabase Postgres.
# Without these, push notifications are silently disabled.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Full service account JSON on a single line
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ==========================================
# SENTRY ERROR TRACKING
# ==========================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ==========================================
# CORS
# ==========================================
ALLOWED_ORIGINS=https://canteen20.vercel.app,https://staging.canteen20.vercel.app

# ==========================================
# FRONTEND BUILD VARS (Vite inlines these into the public JS bundle)
# ==========================================
# Must match the Supabase project above. Never hardcode these in src/config.ts —
# anything in the bundle is public and cannot be rotated without a rebuild.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Empty = same-origin requests. Correct for prod behind one domain.
VITE_API_BASE_URL=
