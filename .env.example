# POSTGRES_URL: Supabase PostgreSQL connection string (pooler mode recommended)
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
POSTGRES_URL=""

# SUPABASE_URL: Supabase project URL (used for Auth — email+password sign-in)
SUPABASE_URL=""

# SUPABASE_ANON_KEY: Supabase publishable anon key (JWT verification server-side)
SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: Supabase service role key (server-side admin ops, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=""

# GEMINI_API_KEY: Required for Gemini AI API calls (AI recommendations, sentiment analysis)
GEMINI_API_KEY=""

# APP_URL: The URL where this app is hosted (for OAuth/callbacks)
APP_URL="https://canteen20-liart.vercel.app"

# Razorpay (optional — enables card/netbanking/wallet payments)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# VyaparGateway (optional — enables UPI Dynamic QR payments)
VYAPAR_API_KEY=""
VYAPAR_MERCHANT_ID=""
VYAPAR_SECRET=""

# Resend (optional — enables superadmin OTP email delivery)
RESEND_API_KEY=""

# QR Secret (optional — HMAC signing for QR codes, auto-generated if not set)
QR_SECRET=""

# REDIS_URL: Optional. Without it the cache is per-process in-memory, which on
# serverless means every cold start / isolated lambda serves stale canteen data.
# REDIS_URL=""

# SENTRY_DSN: Optional. Enables error reporting + profiling in production.
# SENTRY_DSN=""

# Firebase Cloud Messaging (optional — enables push notifications).
# Firebase is used ONLY for push here; the database is Supabase Postgres.
# FIREBASE_PROJECT_ID=""
# FIREBASE_SERVICE_ACCOUNT=""

# --- Frontend build vars (Vite inlines these into the public JS bundle) ---
# VITE_SUPABASE_URL: Supabase project URL, used client-side to refresh auth tokens
VITE_SUPABASE_URL=""
# VITE_SUPABASE_ANON_KEY: Supabase anon/publishable key (safe to expose; RLS applies)
VITE_SUPABASE_ANON_KEY=""
# VITE_API_BASE_URL: Leave empty for same-origin prod; empty also = Vite dev proxy
VITE_API_BASE_URL=""
